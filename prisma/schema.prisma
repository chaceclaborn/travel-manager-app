// Prisma Schema for Travel Manager
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User & Auth ───

model User {
  id        String   @id // matches Supabase auth UUID
  email     String   @unique
  // Public handle, unique case-insensitively (enforced app-side via lowercase
  // compare + DB unique index). Nullable so signup never blocks on it;
  // auto-generated from email and backfilled. Used to find & add real friends.
  username  String?  @unique
  // When true (default), this account appears in friend search so others can
  // find & add it by @handle. Turn off to stay out of search results; the
  // account can still be added by anyone who knows the exact username.
  isPublic  Boolean  @default(true)
  name      String?
  avatarUrl     String?
  homeCity      String?
  homeLatitude  Float?
  homeLongitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trips       Trip[]
  vendors     Vendor[]
  clients     Client[]
  friends     Friend[]
  // Contacts other people hold that point back at this account (see
  // Friend.linkedUserId). Needed only to satisfy the relation.
  linkedAsFriend         Friend[]     @relation("FriendLinkedUser")
  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
  tripCollaborations     TripCollaborator[] @relation("TripCollaboratorUser")
  sentTripInvites        TripCollaborator[] @relation("TripCollaboratorInviter")
  attachments TripAttachment[]
  auditLogs   AuditLog[]
  expenses        Expense[]
  bookings        Booking[]
  checklists      ChecklistItem[]
  tripNotes       TripNote[]
  clickEvents     ClickEvent[]
  feedbacks       Feedback[]
  meetings        Meeting[]
  deviceTokens    DeviceToken[]
  notificationLogs NotificationLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // sign_in, sign_out, data_export, account_delete
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Travel Manager ───

enum AttachmentCategory {
  FLIGHT
  HOTEL
  CAR_RENTAL
  OTHER
}

enum TripStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TripType {
  PERSONAL
  WORK
}

enum VendorCategory {
  SUPPLIER
  HOTEL
  TRANSPORT
  RESTAURANT
  OTHER
}

enum ExpenseCategory {
  FLIGHT
  HOTEL
  TRANSPORT
  FOOD
  ACTIVITIES
  INSURANCE
  VISA
  SHOPPING
  OTHER
}

enum BookingType {
  FLIGHT
  HOTEL
  CAR_RENTAL
  TRAIN
  BUS
  OTHER
}

enum TransportMode {
  FLIGHT
  CAR
}

enum FeedbackCategory {
  BUG
  FEATURE
  UX
  OTHER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model Trip {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  title       String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  status      TripStatus      @default(DRAFT)
  tripType    TripType        @default(PERSONAL)
  notes       String?
  budget      Float?
  shareToken      String?   @unique
  shareEnabled    Boolean   @default(false)
  shareExpiresAt  DateTime?
  // Route home-leg opt-outs: the Route card assumes trips depart from and
  // return to the user's home. These let a trip drop either assumption
  // (e.g. a trip that started from another trip's endpoint).
  hideHomeDeparture Boolean @default(false)
  hideHomeReturn    Boolean @default(false)
  vendors     TripVendor[]
  clients     TripClient[]
  friends     TripFriend[]
  collaborators TripCollaborator[]
  itinerary   ItineraryItem[]
  attachments TripAttachment[]
  stops       TripStop[]
  latitude     Float?
  longitude    Float?
  transportMode          TransportMode?
  departureAirportCode   String?
  departureAirportName   String?
  departureAirportLat    Float?
  departureAirportLng    Float?
  arrivalAirportCode     String?
  arrivalAirportName     String?
  arrivalAirportLat      Float?
  arrivalAirportLng      Float?
  expenses     Expense[]
  bookings     Booking[]
  checklists   ChecklistItem[]
  tripNotes    TripNote[]
  meetings     Meeting[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}

// A place visited within a trip — beyond the single top-level destination.
// e.g. flew to El Paso (destination) then drove to Marfa, White Sands, etc.
model TripStop {
  id        String    @id @default(cuid())
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  name      String
  latitude  Float
  longitude Float
  date      DateTime?
  notes     String?
  // How the traveler got TO this stop from the previous point:
  // drive | flight | train | bus | boat | walk. Free text validated
  // app-side (like Booking.type) — the Trip-level TransportMode enum is
  // intentionally not reused so stop modes can grow without a DB migration.
  travelMode String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tripId, sortOrder])
}

model TripAttachment {
  id          String             @id @default(cuid())
  tripId      String
  trip        Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id])
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  category    AttachmentCategory @default(OTHER)
  createdAt   DateTime           @default(now())

  @@index([tripId])
  @@index([userId])
}

model Vendor {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  name        String
  contactName String?
  category    VendorCategory @default(SUPPLIER)
  email       String?
  phone       String?
  address  String?
  city     String?
  state    String?
  website  String?
  notes    String?
  trips          TripVendor[]
  itineraryItems ItineraryItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
}

model Client {
  id      String       @id @default(cuid())
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  name    String
  company String?
  email   String?
  phone   String?
  notes   String?
  trips          TripClient[]
  itineraryItems ItineraryItem[]
  meetings       Meeting[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
}

model TripVendor {
  id       String @id @default(cuid())
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId String
  notes    String?

  @@unique([tripId, vendorId])
}

model TripClient {
  id       String @id @default(cuid())
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  notes    String?

  @@unique([tripId, clientId])
}

// A personal travel companion — the leisure-side counterpart to Client.
// Friends are user-owned contacts that can be attached to any trip.
model Friend {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  name   String
  email  String?
  phone  String?
  notes  String?
  // Set when this contact came from an accepted account-to-account Friendship,
  // pointing at the connected account. Nullable because most Friends are just
  // private contacts typed in by hand and have no account behind them.
  //
  // This is what makes a connection mean something: accepting a request
  // creates one of these on BOTH sides, so the person immediately shows up in
  // the trip companion picker instead of the connection being a dead row in a
  // list. SetNull rather than Cascade on purpose — if the other account is
  // deleted you keep your contact, it just stops being linked.
  linkedUserId   String?
  linkedUser     User?    @relation("FriendLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  trips          TripFriend[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, linkedUserId])
  @@index([userId])
  @@index([linkedUserId])
}

model TripFriend {
  id       String @id @default(cuid())
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId   String
  friend   Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)
  friendId String
  notes    String?

  @@unique([tripId, friendId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum TripRole {
  VIEWER
  EDITOR
}

enum TripCollaboratorStatus {
  PENDING
  ACCEPTED
}

/// A friend granted access to someone else's Trip.
///
/// The trip OWNER is Trip.userId and is never a row here — modelling the owner
/// as a row too would create two sources of truth and an "owner can be removed"
/// failure mode.
///
/// Access requires status = ACCEPTED *and* a live ACCEPTED Friendship between
/// userId and the trip owner, re-checked on every request. The friendship is a
/// continuing precondition, not a one-time gate: removeFriendship() deletes only
/// the Friendship row, so anything cached or purely row-based would leave an
/// unfriended user with access forever. Never key access off Friend.linkedUserId
/// — that field survives unfriending by design.
model TripCollaborator {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("TripCollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User     @relation("TripCollaboratorInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  role        TripRole               @default(VIEWER)
  status      TripCollaboratorStatus @default(PENDING)
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Doubles as duplicate-invite protection: P2002 becomes a clean 409.
  @@unique([tripId, userId])
  @@index([userId, status])
  @@index([tripId])
}

// A real account-to-account connection (mutual). Distinct from Friend, which
// is a private contact. requester sends the request; addressee accepts. A row
// with status ACCEPTED means the two users are connected (direction is only
// historical once accepted). The @@unique prevents duplicate requests in the
// same direction; app logic blocks the reverse duplicate.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model ItineraryItem {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  title     String
  date      DateTime
  endDate   DateTime? // for multi-day/overnight events
  startTime String?
  endTime   String?
  location  String?
  notes     String?
  sortOrder Int      @default(0)
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, date])
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Float
  currency    String          @default("USD")
  category    ExpenseCategory @default(OTHER)
  description String?
  date        DateTime
  receiptPath String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([tripId])
  @@index([userId])
}

model Booking {
  id              String        @id @default(cuid())
  tripId          String?
  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  type            BookingType
  status          BookingStatus @default(ACTIVE)
  provider        String
  confirmationNum String?
  startDateTime   String?
  endDateTime     String?
  timezone        String?
  location        String?
  endLocation     String?
  seat            String?
  notes           String?
  commissionAmount Float?
  commissionRate   Float?
  commissionPaid   Boolean @default(false)
  commissionNotes  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([tripId])
  @@index([userId])
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

model Meeting {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  tripId        String?
  trip          Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title         String
  startDateTime String
  endDateTime   String?
  timezone      String?
  location      String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([tripId])
  @@index([clientId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  label     String
  checked   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  @@index([tripId])
  @@index([userId])
}

model TripNote {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tripId])
  @@index([userId])
}

// ─── Feedback ───

model Feedback {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  message    String
  category   FeedbackCategory @default(OTHER)
  status     FeedbackStatus   @default(NEW)
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([status])
  @@index([userId])
}

// ─── Click Analytics ───

model ClickEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  label     String
  page      String
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([userId, createdAt])
}

// ─── Push Notifications ───
// Stores APNs / Web Push device tokens for a user. One user can have many
// tokens (e.g. iPhone + iPad + desktop web). Tokens are unique globally so
// we can upsert on the token value when a device re-registers.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Records that a specific notification was sent, so the daily reminder cron
// never double-sends. `dedupKey` is a deterministic string per (event, entity,
// lead-time) — e.g. `trip_reminder:<tripId>:3` — and is globally unique, so a
// second attempt to log the same key throws P2002 and the cron skips dispatch.
// This is an at-most-once guarantee: a missed reminder is preferable to a
// duplicate one waking a user twice for the same trip.
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // trip_reminder | meeting_reminder | booking_confirmation
  dedupKey  String   @unique
  entityId  String?  // the Trip/Meeting/Booking id this notification is about
  sentAt    DateTime @default(now())

  @@index([userId])
}

