{
  "applinks": {
    "details": [
      {
        "appIDs": ["H2FK7C8RK2.com.chaceclaborn.travelmanager"],
        "components": [
          {
            "/": "/api/*",
            "exclude": true,
            "comment": "Never hand API traffic to the app. The OAuth callback and every data endpoint must stay in the browser."
          },
          {
            "/": "/auth/*",
            "exclude": true,
            "comment": "Sign-in redirects land here. Claiming this path would open the app mid-flow and break Google and Apple sign-in for every user."
          },
          {
            "/": "/tour*",
            "exclude": true,
            "comment": "Marketing and the email-confirmation landing page belong in the browser, where someone without the app can still read them."
          },
          {
            "/": "/share/*",
            "exclude": true,
            "comment": "The public share page ships ONLY as page.web.tsx, so it does not exist in the iOS static export. Claiming it would open the app onto a route with no index.html, Capacitor would fall back to index.html, and the recipient would land on the dashboard with no way to read the trip. It also belongs in the browser: most people opening a share link do not have the app."
          },
          { "/": "/trips/*" },
          { "/": "/bookings/*" },
          { "/": "/clients/*" },
          { "/": "/vendors/*" },
          { "/": "/meetings*" },
          { "/": "/map*" }
        ]
      }
    ]
  }
}
