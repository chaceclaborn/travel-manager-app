# No trailing slash: `node_modules/` matches only a real directory, so a
# node_modules SYMLINK (as used to share deps between git worktrees) slipped
# past it and got committed, which broke `yarn install` on Vercel with
# "EEXIST: file already exists, mkdir '/vercel/path0/node_modules'".
node_modules
.next/
.env.local
.env
*.tsbuildinfo
next-env.d.ts
src/lib/generated/
/.claude
!/.claude/agents
!/.claude/agents/**

# Capacitor
# Native iOS project is platform-specific and regenerated by `yarn mobile:init`.
/ios
# Next.js static export output for mobile builds.
/out

# Security audit reports — local-only, may reference file:line vuln details
/security-audits

# App Store screenshot captures — uploaded via fastlane deliver, not source
/app-store-screenshots

# Playwright artifacts
/playwright-report
/test-results
.vercel
